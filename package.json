{
  "name": "trafego-agente-pago",
  "version": "1.1.0",
  "description": "Agente de trafego pago (Meta Ads e Google Ads) com roteamento automatico de skills para Claude Code (plugin) e ChatGPT (servidor MCP).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/validate.mjs && node --test",
    "route": "node router/router.mjs",
    "skills": "node router/router.mjs --list",
    "docs": "node scripts/gen-skills-doc.mjs",
    "mcp": "node mcp/server.mjs",
    "mcp:stdio": "node mcp/server.mjs --stdio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crissuboy-arch/trafego-agente-pago.git"
  }
}
