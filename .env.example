# Trafego Agente Pago — variaveis para integracoes FUTURAS (nao usadas pelo nucleo atual).
# Copie para .env (ignorado pelo Git) e preencha somente se for usar uma integracao.
# Nenhuma skill publica, gasta ou altera orcamento sem confirmacao explicita.

# Meta Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_PIXEL_ID=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=000-000-0000

# Seguranca: exige confirmacao para qualquer escrita em conta real (manter true)
TRAFEGO_REQUIRE_CONFIRMATION=true
